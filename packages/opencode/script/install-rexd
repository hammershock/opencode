#!/usr/bin/env bash
set -euo pipefail

APP=opencode-rexd
INSTALL_DIR="${OPENCODE_REXD_INSTALL_DIR:-${HOME}/.local/bin}"
BINARY=""
MANIFEST=""
PROVISION_BAIDU_APP=0
usage() {
  cat <<EOF
Install a local OpenCode Rexd build without replacing the upstream opencode command.

Usage:
  ./script/install-rexd --binary <path> [--manifest <path>] [--install-dir <path>] [--provision-baidu-app]

An existing opencode-rexd build is replaced. No compatibility copy or rollback
entrypoint is retained.

--provision-baidu-app reads the release credential JSON only from stdin and
writes it to the platform secure store after validating the candidate.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --binary)
      BINARY="${2:-}"
      shift 2
      ;;
    --manifest)
      MANIFEST="${2:-}"
      shift 2
      ;;
    --install-dir)
      INSTALL_DIR="${2:-}"
      shift 2
      ;;
    --provision-baidu-app)
      PROVISION_BAIDU_APP=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

mkdir -p "$INSTALL_DIR"
CURRENT="$INSTALL_DIR/$APP"
CURRENT_MANIFEST="$INSTALL_DIR/$APP.build.json"

if [[ -z "$BINARY" || ! -f "$BINARY" ]]; then
  echo "--binary must name an existing build" >&2
  exit 2
fi
if [[ -n "$MANIFEST" && ! -f "$MANIFEST" ]]; then
  echo "--manifest must name an existing file" >&2
  exit 2
fi

candidate="$INSTALL_DIR/.$APP.candidate.$$"
candidate_manifest="$INSTALL_DIR/.$APP.candidate-manifest.$$"
backup="$INSTALL_DIR/.$APP.backup.$$"
backup_manifest="$INSTALL_DIR/.$APP.backup-manifest.$$"
had_current=0
had_current_manifest=0
commit_started=0
commit_complete=0

cleanup() {
  exit_code=$?
  if [[ "$commit_started" -eq 1 && "$commit_complete" -eq 0 ]]; then
    rollback_failed=0
    if [[ "$had_current" -eq 1 ]]; then
      mv -f "$backup" "$CURRENT" || rollback_failed=1
    else
      rm -f "$CURRENT" || rollback_failed=1
    fi
    if [[ "$had_current_manifest" -eq 1 ]]; then
      mv -f "$backup_manifest" "$CURRENT_MANIFEST" || rollback_failed=1
    else
      rm -f "$CURRENT_MANIFEST" || rollback_failed=1
    fi
    if [[ "$rollback_failed" -ne 0 ]]; then
      echo "Installation rollback failed; preserved backup paths: $backup $backup_manifest" >&2
      exit_code=1
    fi
  fi
  rm -f "$candidate" "$candidate_manifest"
  if [[ "$commit_complete" -eq 1 || "$commit_started" -eq 0 ]]; then
    rm -f "$backup" "$backup_manifest"
  fi
  trap - EXIT
  exit "$exit_code"
}
trap cleanup EXIT

cp "$BINARY" "$candidate"
chmod 755 "$candidate"
candidate_version=$("$candidate" --version)
if [[ -z "$candidate_version" ]]; then
  echo "Candidate did not report a version; existing install was not changed" >&2
  exit 1
fi
if [[ -n "$MANIFEST" ]]; then
  cp "$MANIFEST" "$candidate_manifest"
  if ! "$candidate" __deploy-verify-build-manifest < "$candidate_manifest"; then
    echo "Build manifest is invalid; existing install was not changed" >&2
    exit 1
  fi
fi

if [[ "$PROVISION_BAIDU_APP" -eq 1 ]]; then
  if ! "$candidate" __deploy-provision-baidu-app; then
    echo "Baidu OAuth application provisioning failed; existing install was not changed" >&2
    exit 1
  fi
fi

if [[ -e "$CURRENT" || -L "$CURRENT" ]]; then
  cp -p "$CURRENT" "$backup"
  had_current=1
fi
if [[ -e "$CURRENT_MANIFEST" || -L "$CURRENT_MANIFEST" ]]; then
  cp -p "$CURRENT_MANIFEST" "$backup_manifest"
  had_current_manifest=1
fi

commit_started=1
mv "$candidate" "$CURRENT"
if [[ -e "$candidate_manifest" ]]; then
  mv "$candidate_manifest" "$CURRENT_MANIFEST"
else
  rm -f "$CURRENT_MANIFEST"
fi
installed_version=$("$CURRENT" --version)
if [[ "$installed_version" != "$candidate_version" ]]; then
  echo "Installed candidate smoke check failed; restoring previous install" >&2
  exit 1
fi
if [[ -n "$MANIFEST" ]] && ! "$CURRENT" __deploy-verify-build-manifest < "$CURRENT_MANIFEST"; then
  echo "Installed manifest smoke check failed; restoring previous install" >&2
  exit 1
fi
commit_complete=1

echo "Installed $CURRENT ($candidate_version)"
echo "Add $INSTALL_DIR to PATH if it is not already present."
